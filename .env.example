# Copy this file to .env and replace placeholders locally. Never commit .env.

# 5paisa / Xstream credentials
FIVEPAISA_APP_KEY=YOUR_APP_KEY
FIVEPAISA_SECRET=YOUR_APP_SECRET
FIVEPAISA_APP_NAME=YOUR_APP_NAME
FIVEPAISA_APP_SOURCE=YOUR_APP_SOURCE
FIVEPAISA_USER_ID=YOUR_USER_ID
FIVEPAISA_CLIENT_CODE=YOUR_TRADING_ACCOUNT_CLIENT_CODE
FIVEPAISA_PASSWORD=YOUR_PASSWORD
FIVEPAISA_USER_KEY=YOUR_USER_KEY
FIVEPAISA_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY
FIVEPAISA_TOTP_SECRET=YOUR_TOTP_SECRET_KEY
FIVEPAISA_MPIN=YOUR_6_DIGIT_MPIN

# Optional MLflow override; config.yaml defaults to a local file store.
# ORB__RUN__TRACKING_URI=sqlite:///mlflow.db

# Optional application overrides. Nested YAML keys use a double underscore.
# ORB__RISK__CAPITAL=750000
# ORB__RUN__NAME=local-research
# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
ORB_LOG_LEVEL=INFO
